# Tashner Home Hub kiosk settings. Copy to kiosk/kiosk.conf (untracked) and edit.
# Plain KEY="value" shell syntax. Re-run `sudo ./install.sh` and reboot after changes.

# URL of the hub server (placeholder; use your server's real LAN name or IP).
# Leave off any query: hub-kiosk-launch adds ?display=wall so this browser is a wall display.
HUB_URL="http://hub.local:3000"

# Health endpoint used by the watchdog to decide whether the server is reachable.
HUB_HEALTH_URL="http://hub.local:3000/healthz"

# Display orientation: normal | 90 | 180 | 270 (also rotates touch input).
ORIENTATION="normal"

# Output name as shown by `wlr-randr` (HDMI-A-1 or HDMI-A-2 on a Pi 5).
OUTPUT="HDMI-A-1"

# Render resolution. 2560x1440 is the default; 3840x2160 only if the bench test is smooth.
RESOLUTION="2560x1440"

# Optional: override the touch calibration matrix (six numbers). Empty = use the built-in table.
TOUCH_MATRIX=""

# Input: touch (hidden pointer) for the touch screen, or mouse while driving it with a mouse and
# keyboard (e.g. on a TV): a visible pointer, and Esc minimizes the hub to reach the desktop.
INPUT="touch"

# Remote debugging port, bound to localhost only. Used by the watchdog.
DEBUG_PORT="9222"

# Display agent (monitor power and touch to wake). All optional.
# Seconds between polls of the hub's power state; 1 keeps "Sleep now" under the 2 s target.
POWER_POLL_SECONDS="1"
# Touch device override, e.g. /dev/input/event4. Empty = auto-detect touchscreens.
TOUCH_DEVICE=""
# HDMI-CEC fallback if wlr-randr cannot switch the output: cec-ctl | cec-client | empty (off).
CEC_BACKEND=""
CEC_DEVICE="/dev/cec0"
# CEC logical address of the monitor (0 = TV).
CEC_ADDRESS="0"
# If the hub is unreachable, a touch-woken screen stays on this many seconds.
OFFLINE_WAKE_SECONDS="120"

# Bluetooth speaker (hub-txj.1). Pick it in the hub's Settings > Music > Speaker; this is only a
# fallback for a fresh install. MAC of the speaker, e.g. AA:BB:CC:DD:EE:FF. Empty = none yet.
BT_SPEAKER=""
# Port of the display agent's speaker API, which the hub server calls. install.sh creates the token.
SPEAKER_API_PORT="8742"
SPEAKER_API_TOKEN_FILE="/etc/hub-kiosk/speaker-api.token"

# Spotify Connect (hub-txj.2): the Pi appears in Spotify as the device "Hub" and plays through the
# Bluetooth speaker. on | off. One-time login: see kiosk/README.md, Spotify Connect.
SPOTIFY_CONNECT="off"
# Volume (0-100) librespot starts at until the hub sets one.
SPOTIFY_INITIAL_VOLUME="40"
