# Copy to .env (git-ignored) and edit. All values are optional.
HUB_TAG=latest
HUB_PORT=3000
# Host folder bind-mounted at /data (SQLite DB, uploads, encrypted credentials).
HUB_DATA_DIR=./data
# Unraid: PUID=99 PGID=100. Mac/OrbStack: leave defaults or use `id -u` / `id -g`.
PUID=1000
PGID=1000
TZ=America/Chicago
# Set when credential encryption lands (generate with: openssl rand -base64 32).
# HUB_SECRET_KEY=
# HUB_ALLOW_PUBLIC=
