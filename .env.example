# Copy to .env (git-ignored) and edit. Never commit real values.

# --- Deployment (compose.yaml) ---
# Image tag to run: main (newest), or sha-<short> to pin.
HUB_TAG=main
HUB_PORT=3000
# Host folder bind-mounted at /data (SQLite DB, uploads, encrypted credentials).
HUB_DATA_DIR=./data
# Unraid: PUID=99 PGID=100. Mac/OrbStack: use `id -u` / `id -g`.
PUID=1000
PGID=1000
TZ=America/New_York

# --- Security ---
# Credential encryption key (AES-256-GCM): base64 of exactly 32 random bytes.
# Generate with: openssl rand -base64 32
# If empty, a key file is created at ${DATA_DIR}/secret.key (mode 0600) on first run.
# Back up whichever you use and keep it identical across hosts: losing the key makes
# stored credentials unrecoverable.
HUB_SECRET_KEY=

# LAN-only by default: requests from non-private source IPs get 403.
# Set to true ONLY if you deliberately expose the hub (e.g. behind your own authenticated proxy).
HUB_ALLOW_PUBLIC=false

# Opt-in remote access over Tailscale: also accept source IPs in 100.64.0.0/10 (Tailscale CGNAT).
# Off by default. The client IP honours XFF_DEPTH (x-forwarded-for depth) like the LAN check.
HUB_ALLOW_TAILSCALE=false

# Nightly DB backups to ${HUB_DATA_DIR}/backups (30 days, min 7 kept). Set to off to disable.
HUB_BACKUPS=on

# Largest request body the server accepts (K/M/G suffix). The image defaults to 20M so big
# data imports work; adapter-node's own default is 512K. Uncomment only to change it.
# BODY_SIZE_LIMIT=20M

# --- Google Calendar (see docs/setup/google-calendar.md) ---
# From your own free Google Cloud project: OAuth client of type "Desktop app".
HUB_GOOGLE_CLIENT_ID=
HUB_GOOGLE_CLIENT_SECRET=

# --- Spotify (see docs/setup/spotify.md) ---
# Client id of your own free Spotify developer app (PKCE: no client secret needed).
HUB_SPOTIFY_CLIENT_ID=

# --- Bluetooth speaker on the Pi kiosk (see kiosk/README.md, "Bluetooth speaker") ---
# The wall display's speaker API (port 8742) and the token from /etc/hub-kiosk/speaker-api.token
# on the Pi. Both empty = Settings > Music > Speaker says it is not set up.
HUB_KIOSK_SPEAKER_URL=
HUB_KIOSK_SPEAKER_TOKEN=

# --- Photo frame (see docs/deploy/unraid.md) ---
# Host folder mounted read-only at /media/photos-in inside the container.
HUB_PHOTO_DIR=./photo-library
# Container paths a photo source may use (comma-separated). ${DATA_DIR}/photo-library is always allowed.
HUB_PHOTO_ROOTS=/media/photos-in
# Rescan folders every 15 minutes; set to off to scan only on demand.
HUB_PHOTO_SCAN=on
