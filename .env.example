# Copy to .env for local development. Never commit real values.

# Credential encryption key (AES-256-GCM): base64 of exactly 32 random bytes.
# Generate with: openssl rand -base64 32
# If unset, a key file is created at ${DATA_DIR}/secret.key (mode 0600) on first run.
# Back up whichever you use: losing the key makes stored credentials unrecoverable.
HUB_SECRET_KEY=

# LAN-only by default: requests from non-private source IPs get 403.
# Set to true ONLY if you deliberately expose the hub (e.g. behind your own authenticated proxy).
HUB_ALLOW_PUBLIC=false
